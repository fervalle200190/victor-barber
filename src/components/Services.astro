---
import SplitText from "./SplitText.astro";
import ServicePreview from "./ServicePreview";
import { services } from "@/data/site";
---

<!--
  Carta de servicios. Al pasar el cursor por un servicio, la fila se rellena,
  se despliega la descripción y aparece su foto flotando (ServicePreview).
  En pantallas táctiles la descripción se ve siempre.
-->
<section id="carta" class="py-[clamp(80px,12vw,160px)]">
  <div class="wrap">
    <p class="eyebrow" data-r>La carta</p>
    <SplitText as="h2" text="Servicios" data-r class="mt-4 text-[clamp(44px,7vw,96px)] leading-none" />

    <div class="mt-14 grid grid-cols-1 gap-x-18 lg:grid-cols-2">
      {services.map((s, i) => (
        <div
          tabindex="0"
          data-r
          data-service
          data-image={s.image}
          data-placeholder={s.placeholder}
          style={`--d:${i % 2}`}
          class="group relative isolate -mx-3.5 cursor-default border-b border-line px-3.5 py-6.5 before:absolute before:inset-0 before:-z-1 before:origin-bottom before:scale-y-0 before:bg-stone-2 before:transition-transform before:duration-500 before:ease-silk hover:before:scale-y-100"
        >
          <div class="flex items-baseline gap-3">
            <h3 class="text-[clamp(22px,2.2vw,30px)] transition-[color,translate] duration-500 group-hover:translate-x-2 group-hover:text-gold">
              {s.name}
            </h3>
            <span class="flex-1 -translate-y-1.5 border-b border-dotted border-muted"></span>
            <span class="font-display text-[22px] tabular-nums">{s.price}</span>
          </div>
          <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 group-hover:grid-rows-[1fr] group-focus-within:grid-rows-[1fr] pointer-coarse:grid-rows-[1fr]">
            <div class="overflow-hidden">
              <p class="text-[15.5px] text-muted">
                {s.description}
                <span class="ml-1 text-xs tracking-[0.2em] uppercase">{s.minutes}</span>
              </p>
              {s.bookable !== false && (
                <a
                  href="#reservar"
                  data-book={s.name}
                  class="mt-3 inline-flex min-h-11 items-center gap-2 text-[13px] tracking-[0.2em] text-ink uppercase underline-offset-4 hover:text-gold hover:underline"
                >
                  Reservar <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
  <ServicePreview client:idle />
</section>
