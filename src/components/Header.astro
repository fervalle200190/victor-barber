---
import { contact } from "@/data/site";

const links = [
  { href: "#carta", label: "Carta" },
  { href: "#obra", label: "Obra" },
  { href: "#contacto", label: "Contacto" },
  { href: "#reservar", label: "Reservar" },
];
---

<div class="scroll-bar fixed top-0 left-0 z-60 h-0.5 bg-gold" aria-hidden="true"></div>

<header class="fixed inset-x-0 top-0 z-50 pt-[env(safe-area-inset-top,0px)] text-white mix-blend-difference">
  <div class="wrap flex items-center justify-between py-5.5">
    <a href="#top" class="font-display text-[22px] tracking-[0.2em] no-underline uppercase">{contact.name}</a>
    <nav class="flex gap-8 text-[13px] tracking-[0.2em] uppercase">
      {links.map((l, i) => (
        <a href={l.href} class:list={["no-underline", i < links.length - 1 && "max-md:hidden"]}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .scroll-bar {
    width: calc(var(--sy, 0) * 100%);
  }
</style>
